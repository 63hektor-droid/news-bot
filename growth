def bot_api(method, **data):
    token = env("BOT_TOKEN")
    if not token:
        return None
    try:
        r = requests.post("https://api.telegram.org/bot%s/%s" % (token, method), data=data, timeout=20)
        return r.json()
    except Exception as ex:                                        # noqa
        print("bot api %s failed: %s" % (method, type(ex).__name__))   # عمداً بدون متن خطا (ممکنه توکن داشته باشه)
        return None


def notify(text):
    """پیام کوتاه به چت خود مالک (اگر OWNER_CHAT_ID تنظیم شده)."""
    chat = env("OWNER_CHAT_ID")
    if chat:
        bot_api("sendMessage", chat_id=chat, text=text, parse_mode="HTML", disable_web_page_preview="true")


def resolve_channel(default):
    explicit = env("GROWTH_CHANNEL")
    if explicit:
        return "@" + explicit.lstrip("@"), {}
    cid = env("CHANNEL_ID")
    if cid:
        if cid.startswith("@"):
            return cid, {}
        j = bot_api("getChat", chat_id=cid)
        res = (j or {}).get("result") or {}
        if res.get("username"):
            return "@" + res["username"], res
        raise RuntimeError("کانال شما username عمومی ندارد (یا CHANNEL_ID اشتباه است). "
                           "برای تبادل، کانال باید عمومی باشد یا GROWTH_CHANNEL را در workflow تنظیم کن.")
    if default:
        return default, {}
    raise RuntimeError("کانال مشخص نیست: CHANNEL_ID یا GROWTH_CHANNEL را تنظیم کن.")


def load_cfg():
    name = env("GROWTH_PROFILE", "news").lower()
    if name not in PROFILES:
        raise RuntimeError("پروفایل ناشناخته: %s (news یا reels)" % name)
    cfg = dict(PROFILES[name])
    cfg["profile"] = name
    handle, chat = resolve_channel(cfg.get("default_channel"))
    cfg["my_handle"] = handle
    cfg["my_title"] = chat.get("title") or handle
    cfg["about"] = env("GROWTH_ABOUT", cfg["about"])
    return cfg


async def make_client():
    from telethon import TelegramClient
    from telethon.sessions import StringSession
    client = TelegramClient(StringSession(env("TG_SESSION")), int(env("TG_API_ID", "0")), env("TG_API_HASH"))
    await client.connect()
    if not await client.is_user_authorized():
        await client.disconnect()
        raise RuntimeError("TG_SESSION نامعتبر یا منقضی است؛ session_generator.py را دوباره اجرا کن.")
    return client


