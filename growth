_EXTRA_COLS = {"admin_id": "INTEGER", "promo_msg_id": "INTEGER", "last_seen_msg_id": "INTEGER"}


def get_conn():
    os.makedirs(os.path.dirname(DB_PATH) or ".", exist_ok=True)
    conn = sqlite3.connect(DB_PATH)
    conn.execute("""
        CREATE TABLE IF NOT EXISTS exchanges (
            channel TEXT PRIMARY KEY COLLATE NOCASE,
            admin_username TEXT,
            contact_date TEXT,
            status TEXT DEFAULT 'contacted',
            our_post_date TEXT,
            their_post_verified_date TEXT,
            notes TEXT
        )""")
    conn.execute("CREATE TABLE IF NOT EXISTS member_history (date TEXT PRIMARY KEY, member_count INTEGER)")
    conn.execute("""CREATE TABLE IF NOT EXISTS posted_videos (
            video_hash TEXT PRIMARY KEY, source_channel TEXT, posted_date TEXT, views INTEGER)""")
    have = {r[1] for r in conn.execute("PRAGMA table_info(exchanges)")}
    for col, typ in _EXTRA_COLS.items():
        if col not in have:
            conn.execute("ALTER TABLE exchanges ADD COLUMN %s %s" % (col, typ))
    conn.commit()
    return conn


def _now():
    return datetime.now(timezone.utc).isoformat()


def db_all(sql, params=()):
    with closing(get_conn()) as c:
        return c.execute(sql, params).fetchall()


def db_run(sql, params=()):
    with closing(get_conn()) as c:
        c.execute(sql, params)
        c.commit()


def already_contacted(channel):
    return bool(db_all("SELECT 1 FROM exchanges WHERE channel=?", (channel,)))


def admin_contacted(admin_id):
    return bool(db_all("SELECT 1 FROM exchanges WHERE admin_id=? AND status!='failed'", (admin_id,)))


def contacts_today():
    start = datetime.now(timezone.utc).replace(hour=0, minute=0, second=0, microsecond=0).isoformat()
    return db_all("SELECT COUNT(*) FROM exchanges WHERE contact_date>=? AND status!='failed'", (start,))[0][0]


def add_contact(channel, admin_username, admin_id=None, status="contacted", notes=""):
    db_run("INSERT OR IGNORE INTO exchanges (channel, admin_username, admin_id, contact_date, status, notes) "
           "VALUES (?,?,?,?,?,?)", (channel, admin_username, admin_id, _now(), status, notes))


_ALLOWED = {"our_post_date", "their_post_verified_date", "notes", "promo_msg_id", "last_seen_msg_id"}


def update_status(channel, status, **fields):
    sets, vals = ["status=?"], [status]
    for k, v in fields.items():
        if k not in _ALLOWED:
            raise ValueError(k)
        sets.append("%s=?" % k)
        vals.append(v)
    vals.append(channel)
    db_run("UPDATE exchanges SET %s WHERE channel=?" % ", ".join(sets), vals)


def set_last_seen(channel, msg_id):
    db_run("UPDATE exchanges SET last_seen_msg_id=? WHERE channel=?", (msg_id, channel))


def record_member_count(count):
    today = datetime.now(timezone.utc).date().isoformat()
    db_run("INSERT OR REPLACE INTO member_history (date, member_count) VALUES (?,?)", (today, count))


def member_history(days=8):
    rows = db_all("SELECT date, member_count FROM member_history ORDER BY date DESC LIMIT ?", (days,))
    return list(reversed(rows))


def is_duplicate(video_hash):
    return bool(db_all("SELECT 1 FROM posted_videos WHERE video_hash=?", (video_hash,)))


def record_posted_video(video_hash, source_channel, views):
    db_run("INSERT OR IGNORE INTO posted_videos (video_hash, source_channel, posted_date, views) VALUES (?,?,?,?)",
           (video_hash, source_channel, _now(), views))


