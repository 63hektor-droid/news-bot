#  ۲) ارسال پیشنهاد تبادل به ادمین
# =====================================================================
async def find_contact(client, entity, handle):
    """ادمینِ قابل پیام‌دادن (با username). اول ادمین‌های کانال، بعد @آیدی داخل بیو."""
    from telethon.tl.functions.channels import GetFullChannelRequest, GetParticipantsRequest
    from telethon.tl.types import ChannelParticipantCreator, ChannelParticipantsAdmins, User
    try:
        parts = await client(GetParticipantsRequest(entity, ChannelParticipantsAdmins(), 0, 30, 0))
        umap = {u.id: u for u in parts.users}
        order = []
        for p in parts.participants:
            u = umap.get(getattr(p, "user_id", None))
            if u and not u.bot and not u.deleted and u.username:   # username لازم است تا بعداً پیام‌ها خوانده شوند
                order.append((0 if isinstance(p, ChannelParticipantCreator) else 1, u))
        order.sort(key=lambda x: x[0])
        if order:
            return order[0][1]
    except Exception as e:                                         # noqa
        print("لیست ادمین‌ها در دسترس نیست (%s)" % type(e).__name__)
    try:
        about = (await client(GetFullChannelRequest(entity))).full_chat.about or ""
        for m in re.findall(r"@([A-Za-z][A-Za-z0-9_]{4,31})", about):
            if m.lower() == handle.lstrip("@").lower():
                continue
            try:
                ent = await client.get_entity("@" + m)
            except Exception:                                      # noqa
                continue
            if isinstance(ent, User) and not ent.bot and not ent.deleted and ent.username:
                return ent
    except Exception:                                              # noqa
        pass
    return None


async def already_chatted(client, user):
    """اگر قبلاً با این آدم پیام رد و بدل شده، دوباره پیام نده (حتی اگر دیتابیس پاک شده باشد)."""
    try:
        async for _ in client.iter_messages(user, limit=1):
            return True
    except Exception:                                              # noqa
        return True    # مطمئن نیستیم؛ محتاطانه پیام نده
    return False


async def outreach(client, cfg):
    from telethon import errors
    cands = [h for h, _ in load_candidates()]
    if not cands:
        print("candidates.txt خالی است.")
        return
    budget = min(MAX_DM_PER_RUN, MAX_DM_PER_DAY - contacts_today())
    if budget <= 0:
        print("سقف پیام روزانه پر شده.")
        return
    sent = 0
    for handle in cands:
        if sent >= budget:
            break
        if already_contacted(handle):
            continue
        try:
            entity = await client.get_entity(handle)
        except Exception as e:                                     # noqa
            add_contact(handle, None, status="failed", notes="entity: " + type(e).__name__)
            continue
        admin = await find_contact(client, entity, handle)
        if not admin:
            add_contact(handle, None, status="failed", notes="no reachable admin")
            continue
        if admin_contacted(admin.id) or await already_chatted(client, admin):
            add_contact(handle, admin.username, admin.id, status="failed", notes="admin already contacted")
            continue
        text = random.choice(cfg["pitches"]).format(me=cfg["my_handle"], about=cfg["about"])
        try:
            await client.send_message(admin, text)
        except (errors.PeerFloodError, errors.FloodWaitError) as e:
            print("تلگرام محدودیت اسپم اعلام کرد (%s) → توقف." % type(e).__name__)
            notify("⚠️ تلگرام برای ارسال پیام تبادل محدودیت اعلام کرد؛ ارسال متوقف شد. چند روز صبر کن و GROWTH_MAX_DM را کمتر کن.")
            break
        except Exception as e:                                     # noqa
            add_contact(handle, admin.username, admin.id, status="failed", notes="send: " + type(e).__name__)
            continue
        add_contact(handle, admin.username, admin.id)
        sent += 1
        print("پیشنهاد تبادل برای %s فرستاده شد." % handle)
        await asyncio.sleep(random.randint(MIN_DELAY, MAX_DELAY))
    print("در این اجرا %d پیام تبادل فرستاده شد." % sent)


