FA_RX = re.compile(r"[\u0600-\u06FF]")


def load_candidates():
    if not os.path.exists(CANDIDATES_FILE):
        return []
    out = []
    with open(CANDIDATES_FILE, encoding="utf-8") as f:
        for line in f:
            p = line.split()
            if p:
                out.append((p[0], int(p[1]) if len(p) > 1 and p[1].isdigit() else 0))
    return out


async def find_channels(client, cfg):
    from telethon import errors
    from telethon.tl.functions.channels import GetFullChannelRequest
    from telethon.tl.functions.contacts import SearchRequest
    from telethon.tl.types import Channel

    os.makedirs(STATE_DIR, exist_ok=True)
    cands = load_candidates()
    pending = sum(1 for h, _ in cands if not already_contacted(h))
    if pending >= MAX_PENDING_CANDIDATES:
        print("کاندید تماس‌نگرفته کافی داریم (%d)، جست‌وجو رد شد." % pending)
        return
    known = {h.lower() for h, _ in cands}
    mine = cfg["my_handle"].lower()
    lookups = found = 0

    for kw in cfg["keywords"]:
        if lookups >= MAX_LOOKUPS_PER_RUN or found >= MAX_NEW_CANDIDATES:
            break
        try:
            res = await client(SearchRequest(q=kw, limit=30))
        except errors.FloodWaitError as e:
            print("FloodWait روی جست‌وجو: %ds" % e.seconds)
            if e.seconds > 300:
                break
            await asyncio.sleep(e.seconds + 1)
            continue
        except Exception as e:                                     # noqa
            print("جست‌وجو ناموفق: %s" % type(e).__name__)
            continue

        for chat in res.chats:
            if lookups >= MAX_LOOKUPS_PER_RUN or found >= MAX_NEW_CANDIDATES:
                break
            # فقط کانال‌های broadcast عمومی؛ گروه، کانال کلاهبرداری/جعلی/محدود رد می‌شود
            if not isinstance(chat, Channel) or not chat.broadcast or not chat.username:
                continue
            if getattr(chat, "scam", False) or getattr(chat, "fake", False) or getattr(chat, "restricted", False):
                continue
            handle = "@" + chat.username
            if handle.lower() == mine or handle.lower() in known or already_contacted(handle):
                continue
            # تعداد ممبر در نتیجهٔ جست‌وجو پر نمی‌شود؛ باید جزئیات کامل کانال گرفته شود
            lookups += 1
            try:
                full = (await client(GetFullChannelRequest(chat))).full_chat
            except errors.FloodWaitError as e:
                print("FloodWait روی جزئیات: %ds" % e.seconds)
                lookups = MAX_LOOKUPS_PER_RUN
                break
            except Exception:                                      # noqa
                continue
            await asyncio.sleep(random.uniform(2, 4))
            members = full.participants_count or 0
            text = (chat.title or "") + " " + (full.about or "")
            if not FA_RX.search(text):
                continue                                           # فارسی نیست
            if not (cfg["min_members"] <= members <= cfg["max_members"]):
                continue
            with open(CANDIDATES_FILE, "a", encoding="utf-8") as f:
                f.write("%s %d\n" % (handle, members))
            known.add(handle.lower())
            found += 1
        await asyncio.sleep(5)
    print("%d کانال جدید پیدا شد (%d درخواست جزئیات)." % (found, lookups))


