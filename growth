async def verify_exchanges(client, cfg):
    my = cfg["my_handle"].lstrip("@").lower()
    try:
        my_id = (await client.get_entity(cfg["my_handle"])).id
    except Exception:                                              # noqa
        my_id = None
    rows = db_all("SELECT channel, contact_date, our_post_date FROM exchanges WHERE status='posted_us'")
    for channel, contact_date, our_post_date in rows:
        since = datetime.fromisoformat(contact_date)
        found = False
        try:
            async for msg in client.iter_messages(channel, limit=50):
                if msg.date.astimezone(timezone.utc) < since:
                    break
                text = (msg.text or "").lower()
                fwd = getattr(getattr(msg, "fwd_from", None), "from_id", None)
                if my in text or (my_id and getattr(fwd, "channel_id", None) == my_id):
                    found = True
                    break
        except Exception as e:                                     # noqa
            print("بررسی %s ناموفق: %s" % (channel, type(e).__name__))
            continue
        if found:
            update_status(channel, "verified", their_post_verified_date=_now())
            print("%s: تأیید شد ✅" % channel)
            notify("✅ تبادل با %s تأیید شد." % html.escape(channel))
        elif our_post_date and datetime.now(timezone.utc) - datetime.fromisoformat(our_post_date) > timedelta(hours=GRACE_HOURS):
            update_status(channel, "broken")
            print("%s: پست متقابل نگذاشتند ⚠️" % channel)
            notify("⚠️ %s تا %d ساعت پست متقابل نگذاشت." % (html.escape(channel), GRACE_HOURS))


