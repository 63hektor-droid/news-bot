def news_posts_24h():
    """تعداد خبرهای ۲۴ ساعت اخیر بات اخبار (اگر state/posted.json در همین ریپو باشد)."""
    path = env("NEWS_STATE", "state/posted.json")
    try:
        with open(path, encoding="utf-8") as f:
            seen = json.load(f).get("title_seen", {})
        now = time.time()
        return sum(1 for v in seen.values() if now - float(v) < 86400)
    except Exception:                                              # noqa
        return None


def daily_report(cfg):
    my = cfg["my_handle"]
    j = bot_api("getChatMemberCount", chat_id=my)
    if not (j and j.get("ok")):
        print("تعداد ممبر گرفته نشد.")
        return
    count = j["result"]
    record_member_count(count)
    hist = member_history(days=30)
    today = datetime.now(timezone.utc).date()
    prev = [c for d, c in hist if d < today.isoformat()]
    d_today = count - prev[-1] if prev else 0
    week_ago = [c for d, c in hist if d <= (today - timedelta(days=7)).isoformat()]
    base_week = week_ago[-1] if week_ago else (hist[0][1] if hist else count)
    d_week = count - base_week

    stats = dict(db_all("SELECT status, COUNT(*) FROM exchanges GROUP BY status"))
    sign = lambda n: ("+%d" % n) if n >= 0 else str(n)                # noqa
    lines = ["📊 <b>گزارش روزانه %s</b>" % html.escape(my), "ممبر فعلی: %d" % count,
             "نسبت به آخرین ثبت: %s" % sign(d_today), "هفت روز اخیر: %s" % sign(d_week)]
    n = news_posts_24h()
    if n is not None:
        lines.append("خبرهای ارسال‌شده در ۲۴ ساعت اخیر: %d" % n)
    lines += ["", "🔄 تبادل‌ها:"]
    for st, cnt in sorted(stats.items(), key=lambda x: -x[1]):
        lines.append("  %s: %d" % (LABELS.get(st, st), cnt))
    notify("\n".join(lines))


