def norm(t):
    t = (t or "").lower()
    for a, b in (("ي", "ی"), ("ك", "ک"), ("أ", "ا"), ("إ", "ا"), ("ؤ", "و"), ("ة", "ه")):
        t = t.replace(a, b)
    t = t.replace("\u200c", " ").replace("\u200f", "").replace("\u200e", "")
    t = re.sub(r"[\u064b-\u065f\u0670\u0640]", "", t)
    t = re.sub(r"[^\w\s]", " ", t)
    t = re.sub(r"(.)\1{2,}", r"\1", t)          # «باشههه» → «باشه»
    return re.sub(r"\s+", " ", t).strip()


DECLINE_PHRASES = [
    "نه ممنون", "نه متشکرم", "نه مرسی", "متاسفم", "متاسفانه", "نمی خوام", "نمیخوام", "نمی خواهم",
    "نمی خوایم", "نمیخوایم", "نمی تونم", "نمیتونم", "نمی شه", "نمیشه", "نباشه", "علاقه ای ندارم",
    "علاقه ای نداریم", "علاقه ندارم", "تبادل نمی کنم", "تبادل نمیکنم", "تبادل نداریم", "تبادل نمی کنیم",
    "قبول ندارم", "قبول نمی کنم", "قبول نمیکنم", "قبول نیست", "نیازی نیست", "نیازی ندارم", "نیازی نداریم",
    "فعلا نه", "خیر ممنون", "پیام نده", "پیام ندید", "پیام ندین", "مزاحم نشید",
    "no thanks", "no thank you", "not interested", "sorry",
]
BARE_DECLINE = {"نه", "خیر", "no", "nope", "نچ"}          # فقط در پیام‌های کوتاه
AGREE_TOKENS = {"باشه", "قبول", "قبوله", "موافقم", "موافق", "اوکی", "اوکیه", "ok", "okay", "حتما",
                "هماهنگ", "هماهنگیم", "بله", "اره", "آره"}
AGREE_PHRASES = ["چرا که نه", "انجام میدیم", "انجام می دیم", "انجام میدم", "انجام می دم", "با کمال میل",
                 "خوشحال میشم", "خوشحال می شم", "مشکلی ندارم", "مشکلی نیست", "اشکالی نداره", "اشکالی ندارد"]
NEG_AFTER = {"نیست", "نمی", "نمیکنم", "نمیشه", "ندارم", "نداریم", "نه", "نکن"}
COND_AFTER = {"ولی", "اما", "فقط", "شرط", "به شرط", "اگه", "اگر"}


def classify(text):
    """'agree' | 'decline' | 'unclear' (رد اول بررسی می‌شود؛ «نباشه»، «قبول نیست» و... موافقت حساب نمی‌شود)."""
    t = norm(text)
    if not t:
        return "unclear"
    toks = t.split()
    padded = " %s " % t
    if any((" %s " % p) in padded for p in DECLINE_PHRASES):
        return "decline"
    if len(toks) <= 4 and any(x in BARE_DECLINE for x in toks):
        return "decline"
    for i, tok in enumerate(toks):
        if tok in AGREE_TOKENS:
            window = toks[i + 1:i + 4]
            if any(w in NEG_AFTER for w in window):
                return "decline"
            if any(w in COND_AFTER for w in toks[i + 1:i + 7]):
                return "unclear"
            return "agree"
    if any((" %s " % p) in padded for p in AGREE_PHRASES):
        return "agree"
    return "unclear"


async def check_replies(client, cfg):
    rows = db_all("SELECT channel, admin_username, contact_date, last_seen_msg_id FROM exchanges "
                  "WHERE status='contacted'")
    now = datetime.now(timezone.utc)
    for channel, username, contact_date, last_seen in rows:
        contact_dt = datetime.fromisoformat(contact_date)
        if not username:
            continue
        try:
            admin = await client.get_entity("@" + username.lstrip("@"))
        except Exception as e:                                     # noqa
            print("resolve %s: %s" % (channel, type(e).__name__))
            continue
        decision, unclear_texts, newest = None, [], last_seen or 0
        try:
            async for msg in client.iter_messages(admin, limit=20):
                if msg.date.astimezone(timezone.utc) < contact_dt:
                    break
                if msg.out or not msg.text:
                    continue
                if last_seen and msg.id <= last_seen:
                    break
                newest = max(newest, msg.id)
                verdict = classify(msg.text)
                if verdict in ("agree", "decline"):
                    decision = verdict
                    break
                unclear_texts.append(msg.text)
        except Exception as e:                                     # noqa
            print("خواندن پاسخ %s ناموفق: %s" % (channel, type(e).__name__))
            continue

        if decision == "agree":
            update_status(channel, "agreed", last_seen_msg_id=newest)
            print("%s: موافقت کرد ✅" % channel)
        elif decision == "decline":
            update_status(channel, "declined", last_seen_msg_id=newest)
            print("%s: رد کرد ❌" % channel)
        elif unclear_texts:
            set_last_seen(channel, newest)
            snippet = html.escape(unclear_texts[0][:200])
            notify("💬 پاسخ نامشخص از ادمین %s (@%s):\n«%s»\nخودت مستقیم جواب بده؛ اگر موافقت کرد، ربات متوجه نمی‌شود مگر پیام بعدی‌اش واضح باشد."
                   % (html.escape(channel), html.escape(username), snippet))
        elif now - contact_dt > timedelta(days=REPLY_TIMEOUT_DAYS):
            update_status(channel, "needs_review" if last_seen else "no_reply")
            print("%s: مهلت پاسخ تمام شد." % channel)


async def _about_of(client, channel):
    from telethon.tl.functions.channels import GetFullChannelRequest
    try:
        full = await client(GetFullChannelRequest(await client.get_entity(channel)))
        about = (full.full_chat.about or "").strip().split("\n")[0]
        return full.chats[0].title, about[:160]
    except Exception:                                              # noqa
        return None, ""


