async def _step(name, coro):
    try:
        await coro
    except Exception as ex:                                        # noqa
        print("مرحلهٔ %s خطا داد:\n%s" % (name, traceback.format_exc()[-500:]))
        notify("⚠️ مرحلهٔ «%s» در ابزار رشد خطا داد: %s" % (name, html.escape(type(ex).__name__)))


async def run_all(mode):
    cfg = load_cfg()
    print("profile=%s channel=%s mode=%s" % (cfg["profile"], cfg["my_handle"], mode))
    client = await make_client()
    try:
        if mode == "full":
            await _step("find_channels", find_channels(client, cfg))
            await _step("outreach", outreach(client, cfg))
        await _step("check_replies", check_replies(client, cfg))
        await _step("post_promos", post_promos(client, cfg))
        await _step("verify", verify_exchanges(client, cfg))
    finally:
        await client.disconnect()
    if mode == "full":
        daily_report(cfg)


